{
  "name": "Roast",
  "type": "light",
  "colors": {
    "editor.background": "#e9e0cc",
    "editor.foreground": "#2b2620"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": {
        "foreground": "#8a7d68",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other",
        "variable.language"
      ],
      "settings": {
        "foreground": "#a4462a"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#7d705b"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#5b6a24"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#9a5b00"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "support.constant"
      ],
      "settings": {
        "foreground": "#9a5b00"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7a4f12"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#8c3f4a"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.readwrite",
        "variable.other",
        "variable"
      ],
      "settings": {
        "foreground": "#2b2620"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.property",
        "variable.other.object.property",
        "entity.other.attribute-name",
        "entity.name.tag.toml",
        "support.type.property-name.toml",
        "keyword.key.toml",
        "entity.other.attribute-name.multipart.nix",
        "entity.other.attribute-name.single.nix"
      ],
      "settings": {
        "foreground": "#6b5232"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading",
        "entity.other.attribute-name.table.toml"
      ],
      "settings": {
        "foreground": "#7a4f12",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "#9a5b00"
      }
    },
    {
      "scope": [
        "support.function.builtin",
        "support.function.builtin.shell",
        "entity.name.command"
      ],
      "settings": {
        "foreground": "#7a4f12"
      }
    },
    {
      "scope": [
        "string.unquoted.path.nix",
        "string.unquoted.spath.nix",
        "constant.other.path"
      ],
      "settings": {
        "foreground": "#5b6a24"
      }
    }
  ]
}
